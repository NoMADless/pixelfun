# ---------------------------------------------------------------------------
# PixelFun — Stage 1 environment
# Copy to .env.local. No database or indexer is used.
# ---------------------------------------------------------------------------

# Mock mode: in-memory canvas + localStorage fake vault. No chain required.
# Set to false for real RPC reads and wallet transactions.
MOCK_MODE=true

# Robinhood Chain (verified official parameters; chain ID 4663 = 0x1237)
NEXT_PUBLIC_CHAIN_ID=4663
NEXT_PUBLIC_RPC_URL=https://rpc.mainnet.chain.robinhood.com
NEXT_PUBLIC_EXPLORER_URL=https://robinhoodchain.blockscout.com

# Deployed contracts. Leave blank with MOCK_MODE=false to show "not deployed yet".
NEXT_PUBLIC_VAULT_ADDRESS=
NEXT_PUBLIC_IMD_ADDRESS=

# Canvas loading. One slot = 32 pixels; 8192 slots total.
# 512 slots = 16,384 pixels per getPixels call => 16 calls for the whole canvas.
# CANVAS_CHUNK_SLOTS is used by the /api/canvas route.
CANVAS_CHUNK_SLOTS=512
# Used when the browser falls back to direct RPC reads.
NEXT_PUBLIC_CANVAS_CHUNK_SLOTS=512

# Optional. Enables the WalletConnect connector for mobile wallets.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
