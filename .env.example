[TEMPLATE]
# ---------------------------------------------------------------------------
# PixelFun — environment (live Robinhood Chain deployment)
# Copy to .env.local. No database or indexer is used.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Live deployment (chain 4663). These are public values, not secrets.
# ---------------------------------------------------------------------------
MOCK_MODE=false

NEXT_PUBLIC_CHAIN_ID=4663
NEXT_PUBLIC_RPC_URL=https://rpc.mainnet.chain.robinhood.com
NEXT_PUBLIC_EXPLORER_URL=https://robin.etherscan.io
NEXT_PUBLIC_VAULT_ADDRESS=0x30da521f63553ec3ea2dbb82c30581c00ccf9009
NEXT_PUBLIC_IMD_ADDRESS=0x5F7Bb59365ce557C26dbcAa4EE9d39A4b95B7127
# Deploy tx, used by npm run check:bytecode.
PIXELFUN_DEPLOY_TX=0xd7c0e30bc98b22a71eff1aa35df2362f131a295cbc981c764c74fc0511b72523
# Contract checkout holding out/PixelFun.sol/PixelFun.json.
PIXELFUN_CONTRACT_REPO=../launch-2148-dsa

# Public origin used for canonical, OG and X share links.
NEXT_PUBLIC_SITE_URL=https://pixelfun.xyz

# Canvas loading. One slot = 32 pixels; 8192 slots total.
# 1024 slots = 32,768 pixels per getPixels call => 8 calls for the whole canvas.
# 1024 is the contract's MAX_READ_SLOTS; the adapter clamps to the live value.
CANVAS_CHUNK_SLOTS=1024
NEXT_PUBLIC_CANVAS_CHUNK_SLOTS=1024

# ---------------------------------------------------------------------------
# Read-only fork suite (npm run e2e:fork). Transactions only on a local Anvil
# fork. The suite skips when ROBINHOOD_RPC_URL is unset.
# ---------------------------------------------------------------------------
ROBINHOOD_RPC_URL=https://rpc.mainnet.chain.robinhood.com
# Optional overrides for the fork suite:
# IMD_ADDRESS=0x5F7Bb59365ce557C26dbcAa4EE9d39A4b95B7127
# IMD_HOLDER=0x...

# DEV ONLY: adds an "Anvil (dev)" wallet that signs with the public Anvil test
# key. Requires NEXT_PUBLIC_CHAIN_ID=31337; the build refuses any other chain.
# Never set this in production.
# NEXT_PUBLIC_LOCAL_DEV=true

# Optional. Enables the WalletConnect connector for mobile wallets.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Set PIXELFUN_ALLOW_UNDEPLOYED=1 only to preview the not-deployed state in a
# production build. Not used for the live deployment.
