# ---------------------------------------------------------------------------
# PixelFun — environment (Stages 1–4)
# Copy to .env.local. No database or indexer is used.
# ---------------------------------------------------------------------------

# Mock mode: in-memory canvas + localStorage fake vault. No chain required.
# Set to false for real RPC reads and wallet transactions.
MOCK_MODE=true

# Robinhood Chain (verified official parameters; chain ID 4663 = 0x1237)
NEXT_PUBLIC_CHAIN_ID=4663
NEXT_PUBLIC_RPC_URL=https://rpc.mainnet.chain.robinhood.com
NEXT_PUBLIC_EXPLORER_URL=https://robinhoodchain.blockscout.com
# Public origin used for canonical, OG and X share links.
NEXT_PUBLIC_SITE_URL=https://pixelfun.xyz

# Deployed contracts. With MOCK_MODE=false a production server refuses to start
# without both addresses and lists what is missing. Set PIXELFUN_ALLOW_UNDEPLOYED=1
# only if you intentionally want to preview the not-deployed state in production.
# Development logs the same validation message but still shows the UI.
NEXT_PUBLIC_VAULT_ADDRESS=
NEXT_PUBLIC_IMD_ADDRESS=

# Canvas loading. One slot = 32 pixels; 8192 slots total.
# 1024 slots = 32,768 pixels per getPixels call => 8 calls for the whole canvas.
# 1024 is the contract's MAX_READ_SLOTS; the adapter clamps to the live value.
# CANVAS_CHUNK_SLOTS is used by the /api/canvas route.
CANVAS_CHUNK_SLOTS=1024
# Used when the browser falls back to direct RPC reads.
NEXT_PUBLIC_CANVAS_CHUNK_SLOTS=1024

# DEV ONLY: adds an "Anvil (dev)" wallet that signs with the public Anvil test
# key. Requires NEXT_PUBLIC_CHAIN_ID=31337; the build refuses any other chain.
# Never set this in production.
# NEXT_PUBLIC_LOCAL_DEV=true

# Optional. Enables the WalletConnect connector for mobile wallets.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
